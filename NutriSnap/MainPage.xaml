<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:NutriSnap.Models"
             x:Class="NutriSnap.MainPage"
             Title="NutriSnap Records"
             BackgroundColor="{AppThemeBinding Light=#F1F8E9, Dark=#121212}">

    <Grid RowDefinitions="Auto, *, Auto" Padding="15">

        <SearchBar x:Name="FoodSearchBar" Grid.Row="0" 
                   Placeholder="Search name, category, or calories..." 
                   TextChanged="OnSearchBarTextChanged" 
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" 
                   TextColor="{AppThemeBinding Light=#333333, Dark=White}"
                   CancelButtonColor="#4CAF50" 
                   Margin="0,0,0,10" />

        <CollectionView x:Name="FoodListView" Grid.Row="1" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:FoodItem">

                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Delete" BackgroundColor="#E53935" Clicked="OnDeleteClicked" CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Frame Margin="0,0,0,15" Padding="15" CornerRadius="12" HasShadow="True"
                               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" 
                               BorderColor="{AppThemeBinding Light=#A5D6A7, Dark=#333333}">
                            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10">

                                <Grid Grid.Column="0" BackgroundColor="Transparent">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFoodItemTapped" />
                                    </Grid.GestureRecognizers>

                                    <VerticalStackLayout VerticalOptions="Center" InputTransparent="True">
                                        <Label Text="{Binding Name}" FontSize="{DynamicResource MediumFont}" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#2E7D32, Dark=#A5D6A7}" />
                                        <Label Text="{Binding Category}" FontSize="{DynamicResource SmallFont}" FontAttributes="Italic" TextColor="{AppThemeBinding Light=#66BB6A, Dark=#81C784}" />
                                        <Label Text="{Binding AccessibleSummary}" FontSize="{DynamicResource SmallFont}" Margin="0,5,0,0" TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}" />
                                    </VerticalStackLayout>
                                </Grid>

                                <Button Grid.Column="1" Text="Read" Clicked="OnReadClicked" CommandParameter="{Binding .}" 
                                        VerticalOptions="Center" BackgroundColor="#81C784" TextColor="White" CornerRadius="8" />
                                <Button Grid.Column="2" Text="Stop" Clicked="OnStopReadClicked" 
                                        VerticalOptions="Center" BackgroundColor="#E57373" TextColor="White" CornerRadius="8" />
                            </Grid>
                        </Frame>
                    </SwipeView>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2" Text="Add New Record" Clicked="OnAddNewClicked" Margin="0,10,0,10" HeightRequest="55" 
                FontSize="{DynamicResource MediumFont}" BackgroundColor="#4CAF50" TextColor="White" CornerRadius="25" FontAttributes="Bold" />

    </Grid>
</ContentPage>