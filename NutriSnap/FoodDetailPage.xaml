<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriSnap.FoodDetailPage"
             Title="Food Details"
             BackgroundColor="#F1F8E9">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Frame CornerRadius="12" Padding="0" IsClippedToBounds="True" HasShadow="True" BorderColor="#A5D6A7">
                <Image Source="{Binding PhotoPath}" HeightRequest="250" Aspect="AspectFill">
                    <Image.Triggers>
                        <DataTrigger TargetType="Image" Binding="{Binding PhotoPath}" Value="">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Image.Triggers>
                </Image>
            </Frame>

            <Frame CornerRadius="12" Padding="20" BackgroundColor="White" HasShadow="True" BorderColor="#A5D6A7">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding Name}" FontSize="{DynamicResource TitleFont}" FontAttributes="Bold" TextColor="#2E7D32" />
                    <Label Text="{Binding Category}" FontSize="{DynamicResource MediumFont}" TextColor="#66BB6A" FontAttributes="Italic" />

                    <BoxView HeightRequest="1" Color="#E8F5E9" Margin="0,10,0,10" />

                    <Grid ColumnDefinitions="Auto, *">
                        <Label Text="Calories:" FontSize="{DynamicResource NormalFont}" FontAttributes="Bold" TextColor="#333333" />
                        <Label Grid.Column="1" Text="{Binding Calories, StringFormat='{0} kcal'}" FontSize="{DynamicResource NormalFont}" TextColor="#555555" Margin="10,0,0,0" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto, *">
                        <Label Text="Location:" FontSize="{DynamicResource NormalFont}" FontAttributes="Bold" TextColor="#333333" />
                        <Label Grid.Column="1" Text="{Binding LocationText}" FontSize="{DynamicResource NormalFont}" TextColor="#555555" Margin="10,0,0,0" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>