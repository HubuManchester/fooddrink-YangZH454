<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriSnap.LoginPage"
             Title="Welcome">

    <VerticalStackLayout Spacing="25" Padding="30" VerticalOptions="Center">

        <Label Text="NutriSnap" FontSize="{DynamicResource HugeFont}" FontAttributes="Bold" HorizontalOptions="Center" />
        <Label Text="Your Personal Nutrition Tracker" FontSize="{DynamicResource NormalFont}" TextColor="Gray" HorizontalOptions="Center" Margin="0,0,0,20" />

        <Entry x:Name="UsernameEntry" Placeholder="Username (e.g., admin)" />
        <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" />

        <Label x:Name="ErrorLabel" TextColor="Red" IsVisible="False" HorizontalOptions="Center" />

        <Button Text="Login" Clicked="OnLoginClicked" HeightRequest="50" FontSize="{DynamicResource MediumFont}" Margin="0,10,0,0" />

    </VerticalStackLayout>

</ContentPage>