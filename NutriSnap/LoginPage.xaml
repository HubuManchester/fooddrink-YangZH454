<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriSnap.LoginPage"
             Title="Welcome"
             BackgroundColor="#E8F5E9">

    <VerticalStackLayout Spacing="25" Padding="30" VerticalOptions="Center">

        <Label Text="NutriSnap" FontSize="{DynamicResource HugeFont}" FontAttributes="Bold" TextColor="#2E7D32" HorizontalOptions="Center" />
        <Label Text="Your Personal Nutrition Tracker" FontSize="{DynamicResource NormalFont}" TextColor="#66BB6A" HorizontalOptions="Center" Margin="0,0,0,20" />

        <Entry x:Name="UsernameEntry" Placeholder="Username (e.g., admin)" BackgroundColor="White" TextColor="#333333" />
        <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" BackgroundColor="White" TextColor="#333333" />

        <Label x:Name="ErrorLabel" TextColor="Red" IsVisible="False" HorizontalOptions="Center" />

        <Button Text="Login" Clicked="OnLoginClicked" HeightRequest="55" FontSize="{DynamicResource MediumFont}" 
                Margin="0,10,0,0" BackgroundColor="#4CAF50" TextColor="White" CornerRadius="25" FontAttributes="Bold" />

    </VerticalStackLayout>
</ContentPage>