<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NutriSnap.SettingsPage"
             Title="Settings">

    <VerticalStackLayout x:Name="SettingsLayout" Spacing="25" Padding="20">

        <Label Text="Accessibility &amp; Preferences" FontSize="{DynamicResource TitleFont}" FontAttributes="Bold" />

        <Grid ColumnDefinitions="*, Auto">
            <Label Text="🌙 Dark Mode" VerticalOptions="Center" FontSize="{DynamicResource NormalFont}" />
            <Switch x:Name="ThemeSwitch" Grid.Column="1" Toggled="OnThemeToggled" />
        </Grid>

        <Grid ColumnDefinitions="*, Auto">
            <Label Text="🔠 Large Text Mode" VerticalOptions="Center" FontSize="{DynamicResource NormalFont}" />
            <Switch x:Name="FontSwitch" Grid.Column="1" Toggled="OnLargeTextToggled" />
        </Grid>

        <Label x:Name="DemoText" Text="This is a preview of your text size." TextColor="Gray" FontSize="{DynamicResource SmallFont}" />

        <BoxView HeightRequest="1" Color="LightGray" Margin="0,20,0,20" />

        <Button Text="Log Out" Clicked="OnLogoutClicked" BackgroundColor="DarkRed" TextColor="White" HeightRequest="50" />

    </VerticalStackLayout>

</ContentPage>