<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:NutriSnap"
             x:Class="NutriSnap.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <x:Double x:Key="SmallFont">14</x:Double>
            <x:Double x:Key="NormalFont">16</x:Double>
            <x:Double x:Key="MediumFont">18</x:Double>
            <x:Double x:Key="TitleFont">22</x:Double>
            <x:Double x:Key="HugeFont">32</x:Double>

        </ResourceDictionary>
    </Application.Resources>
</Application>